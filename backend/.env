# Database: PostGIS (provided by docker-compose.yml)
DATABASE_URL=postgresql+psycopg://roadsight:roadsight_dev_password@localhost:5432/roadsight

# Copy the trained checkpoint into ./models/ and set this path if its name differs
MODEL_PATH=./models/yolov8_pothole_best.pt
MODEL_DEVICE=auto
MODEL_CONFIDENCE=0.25
MODEL_IOU=0.45
MAX_UPLOAD_MB=15

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: set a long random token and send Authorization: Bearer <token>
API_KEY=
