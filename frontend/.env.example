# Your deployed FastAPI origin, e.g. https://your-api.example.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Adjust these to match your FastAPI routes
VITE_DETECT_PATH=/detect
VITE_POTHOLES_PATH=/potholes
VITE_SAVE_REPORT_PATH=/potholes

# Multipart form field expected by your detection endpoint: file or image
VITE_UPLOAD_FIELD=file

# Optional: set true only if your API uses cookie-based auth
VITE_WITH_CREDENTIALS=false
